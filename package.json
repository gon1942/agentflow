{
  "name": "@gon1942/agentflow",
  "version": "0.5.0-rc.1",
  "description": "Project-local AgentFlow skills-first installer for OpenCode, Claude Code and Codex",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
